.git
.gitignore
*

# Include pipeline code
!recsys/
!lib/
lib/*
!lib/ai_recommend_model/
!lib/ai_recommend_model/avatar_generation/
!lib/ai_recommend_model/avatar_generation/**
!infra/
!cloudbuild.yaml
!Dockerfile

# Exclude virtual environments and caches that might be inside included folders
recsys/.venv/
**/.venv/
**/__pycache__/

# Avatar worker Cloud Build context (lib/ai_recommend_model/avatar_generation/Dockerfile)
!requirements_avatar_worker.txt
!cloudbuild.avatar-worker.yaml
